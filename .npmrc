# --- SEGURANÇA DA SUPPLY CHAIN (PADRÃO OURO) ---

# 1. Impede execução de código malicioso durante a instalação (postinstall, etc)
ignore-scripts=true

# 2. Período de Resfriamento (Cooldown)
# Impede a instalação de pacotes recém-publicados.
# Valor constante definido para 7 dias (mitiga ataques de typosquatting)
min-release-age=7d

# 3. Fixa a versão exata no package.json (sem ^ ou ~)
# Previne atualizações automáticas silenciosas
save-exact=true

# 4. Falha a instalação se houver vulnerabilidades de alto risco
audit=true
audit-level=high
