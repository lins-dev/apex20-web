# --- SEGURANÇA DA SUPPLY CHAIN (PADRÃO OURO) ---

# 1. Impede execução de código malicioso durante a instalação (postinstall, etc)
ignore-scripts=true

# 2. Fixa a versão exata no package.json (sem ^ ou ~)
# Previne atualizações automáticas silenciosas
save-exact=true

# 3. Falha a instalação se houver vulnerabilidades de alto risco
audit=true
audit-level=high
